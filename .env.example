# 비밀값은 커밋하지 않는다. 실제 값은 .env(로컬 전용) 또는 --dart-define 으로 주입.
# 예: flutter run --dart-define=PLANTNET_API_KEY=xxxx --dart-define=SUPABASE_URL=... --dart-define=SUPABASE_ANON_KEY=...

# PlantNet API (my-api.plantnet.org, 무료 500회/일) — M2
PLANTNET_API_KEY=

# Supabase 무료 티어 — M4
SUPABASE_URL=
SUPABASE_ANON_KEY=
